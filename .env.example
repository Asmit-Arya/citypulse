# Copy this file to .env and fill in your own values.
# Generate a long random key and never commit .env to source control.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Add your local/deployed origin to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to use this prototype's merchant console.
# Leave empty until merchant access has been assigned explicitly.
MERCHANT_EMAILS=

# Keep true for local prototype/demo only. Set false before public launch.
ENABLE_DEMO_LOGIN=true

# true only when served over HTTPS in production.
COOKIE_SECURE=false

# Optional, only if your separate AI notes modifier is configured.
AI_API_KEY=
AI_ENDPOINT=

# Optional path to a persistent SQLite database.
# CITYPULSE_DB_PATH=/absolute/path/to/citypulse.db

# Password-reset email (required for Forgot Password to send reset links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_SSL=false
